[Unit]
Description=CPU-effektstyrning via MQTT (Home Assistant)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=-/sbin/modprobe intel_rapl_msr
ExecStart=/opt/cpu-power-mqtt/venv/bin/python /opt/cpu-power-mqtt/cpu_power_mqtt.py -c /etc/cpu-power-mqtt.conf
Restart=on-failure
RestartSec=10
User=root

[Install]
WantedBy=multi-user.target
